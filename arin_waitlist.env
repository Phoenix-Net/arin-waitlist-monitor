# ARIN IPv4 Waiting List Monitor configuration
#
# Copy this file to .env (or keep the name arin_waitlist.env).
# The script loads whichever it finds first next to arin_waitlist.py.

# This MUST exactly match the "Date and Time Added to Waiting List"
# shown on https://www.arin.net/resources/guide/ipv4/waiting_list/
ARIN_TARGET_DATE="Tue, 03 Feb 2026, 12:17:25 EST"

# --- Fluxer (primary notifications) ---
# Create a bot on your Fluxer instance, invite it to the guild,
# and paste the bot token + destination channel ID here.
FLUXER_TOKEN="CHANGE_ME"
FLUXER_CHANNEL_ID="CHANGE_ME"

# Official hosted Fluxer:
#   https://api.fluxer.app/v1
# Self-hosted — host only is fine ( /v1 is appended automatically ):
#   https://fluxer.example.com
# Or set the full API base if yours is non-standard:
#   https://fluxer.example.com/api/v1
FLUXER_API_URL="https://api.fluxer.app/v1"

# --- Email (optional; leave blank to skip) ---
# Port 465 = SMTPS (implicit TLS)
# Port 587 = SMTP with STARTTLS
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Email settings
MAIL_FROM=""

# Multiple recipients are supported:
# comma, semicolon, or space separated
MAIL_TO=""

MAIL_SUBJECT_PREFIX="[ARIN Waitlist]"
